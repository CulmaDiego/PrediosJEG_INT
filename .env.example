# Desarrollo: copie como .env únicamente si necesita cambiar estos valores.
PREDIOS_ENV=development
PREDIOS_DATA_DIR=..\PrediosRemotosInt_data_dev
PREDIOS_ORTHOPHOTO_ROOT=Imagenes
PREDIOS_SECRET_KEY=cambie-esto-por-una-clave-aleatoria-de-64-caracteres
